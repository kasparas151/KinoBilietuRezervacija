@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <span class="me-2">Sveiki, @User.Identity.Name</span>
        <button type="submit" class="btn btn-link">Atsijungti</button>
    </form>
}
else
{
    <a class="btn btn-link" asp-controller="Account" asp-action="Login">Prisijungti</a>
    <a class="btn btn-link" asp-controller="Account" asp-action="Register">Registruotis</a>
}
