@model IEnumerable<KinoBilietuRezervacija.Models.Ticket>

@{
    ViewData["Title"] = "Bilietų sąrašas";
}

<h1>Bilietai</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Naujas bilietas</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Filmas</th>
            <th>Data</th>
            <th>Pirkėjas</th>
            <th>Vieta</th>
            <th>Būsena</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Seansas?.Filmas?.Pavadinimas</td>
                <td>@ticket.Seansas?.DataLaikas.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@ticket.PirkejoVardas</td>
                <td>@ticket.VietosNumeris</td>
                <td>@ticket.MokejimoBusena</td>
                <td class="d-flex gap-1 flex-wrap">
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@ticket.ID">Peržiūrėti</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@ticket.ID">Redaguoti</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@ticket.ID">Ištrinti</a>
                    }
                    @if (ticket.MokejimoBusena != "Apmokėta")
                    {
                        <form asp-action="Pay" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@ticket.ID" />
                            <button type="submit" class="btn btn-warning btn-sm">Sumokėti</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-success">Apmokėta</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
